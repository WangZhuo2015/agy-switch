cmd_watch() {
    local passthrough_args=("$@")

    echo -e "${CYAN}${BOLD}=== Antigravity Multi-Account Session Supervisor ===${NC}"
    echo -e "${DIM}Starting mega-quota supervisor. When quota is exhausted, agy will auto-swap and continue with -c.${NC}"
    echo ""

    # Silent background warmup for unstarted accounts
    cmd_warmup silent &

    local need_continue=false
    local auto_prompt=""
    for arg in "${passthrough_args[@]}"; do
        if [[ "$arg" == "-c" || "$arg" == "--continue" ]]; then
            need_continue=true
            break
        fi
    done

    local filtered_args=()
    for arg in "${passthrough_args[@]}"; do
        [[ "$arg" != "-c" && "$arg" != "--continue" ]] && filtered_args+=("$arg")
    done

    while true; do
        local best_info
        best_info=$(_pick_best_account_internal)
        local status
        local best_email
        local best_reason
        status=$(echo "$best_info" | cut -d'|' -f1)
        best_email=$(echo "$best_info" | cut -d'|' -f2)
        best_reason=$(echo "$best_info" | cut -d'|' -f3)

        if [[ "$status" != "SUCCESS" || -z "$best_email" ]]; then
            echo -e "${RED}✗ All accounts are out of quota! Supervisor stopping.${NC}"
            break
        fi

        local token_email=""
        [[ -f "$TOKEN_FILE" ]] && token_email=$(get_email "$TOKEN_FILE")

        if [[ "$token_email" != "$best_email" ]]; then
            cmd_switch "$best_email" >/dev/null
            echo -e "${GREEN}✓ Switched to optimal account: ${CYAN}${BOLD}$best_email${NC} ${DIM}($best_reason)${NC}"
        else
            echo -e "${GREEN}✓ Active account: ${CYAN}${BOLD}$best_email${NC} ${DIM}($best_reason)${NC}"
        fi

        local run_args=()
        if $need_continue; then
            run_args+=("-c")
            if [[ -n "$auto_prompt" ]]; then
                local is_print_mode=false
                for arg in "${filtered_args[@]}"; do
                    [[ "$arg" == "-p" || "$arg" == "--print" ]] && is_print_mode=true
                done
                if $is_print_mode; then
                    run_args+=("-p" "$auto_prompt")
                else
                    run_args+=("-i" "$auto_prompt")
                fi
            fi
        fi

        for ((idx_arg=0; idx_arg<${#filtered_args[@]}; idx_arg++)); do
            local a="${filtered_args[$idx_arg]}"
            if $need_continue && [[ -n "$auto_prompt" ]]; then
                if [[ "$a" == "-i" || "$a" == "--prompt-interactive" || "$a" == "-p" || "$a" == "--print" ]]; then
                    idx_arg=$((idx_arg + 1))
                    continue
                fi
            fi
            run_args+=("$a")
        done
        auto_prompt=""

        local log_file="$HOME/.gemini/antigravity-cli/cli.log"
        local lines_before=0
        [[ -f "$log_file" ]] && lines_before=$(wc -l < "$log_file" 2>/dev/null || echo 0)

        echo -e "${DIM}Launching agy... (Exit with /exit or Ctrl+D to stop session)${NC}"
        echo ""

        set +e
        agy "${run_args[@]}"
        local agy_exit_code=$?
        set -e

        echo ""

        local quota_hit=false
        if [[ -f "$log_file" ]]; then
            local lines_after
            lines_after=$(wc -l < "$log_file" 2>/dev/null || echo 0)
            if [[ $lines_after -gt $lines_before ]]; then
                if tail -n +$((lines_before + 1)) "$log_file" 2>/dev/null | grep -qiE "(RESOURCE_EXHAUSTED|rate.*limit.*exceed|out.*of.*quota|quota.*exceed|Too Many Requests|HTTP 429)"; then
                    quota_hit=true
                fi
            fi
        fi

        if ! $quota_hit; then
            local current_profile="$PROFILES_DIR/$(email_to_filename "$best_email").json"
            if [[ -f "$current_profile" ]]; then
                local current_raw
                current_raw=$(_query_usage_isolated "$current_profile")
                if echo "$current_raw" | grep -qiE "(Limit Remaining[[:space:]]+0%|Limit Remaining[[:space:]]+1%|Limit Remaining[[:space:]]+2%)"; then
                    quota_hit=true
                fi
            fi
        fi

        if $quota_hit; then
            echo -e "${YELLOW}${BOLD}⚡ Account quota exhausted on $best_email!${NC}"
            need_continue=true
            auto_prompt="Continue"

            echo -e "${CYAN}Auto-switching to next best account & continuing with 'Continue' in 3s...${NC}"
            echo -e "${DIM}(Press 'q' to stop, 'n' to resume without auto-prompt, or Enter to resume immediately)${NC}"

            local key=""
            if read -t 3 -n 1 key 2>/dev/null; then
                if [[ "$key" == "q" || "$key" == "Q" ]]; then
                    echo -e "\n${DIM}Supervisor stopped by user.${NC}"
                    break
                elif [[ "$key" == "n" || "$key" == "N" ]]; then
                    echo -e "\n${DIM}Auto-prompt skipped.${NC}"
                    auto_prompt=""
                fi
            fi
            echo ""
            continue
        else
            echo -e "${DIM}Session ended normally. Exiting supervisor.${NC}"
            break
        fi
    done
}

