#!/usr/bin/env bash
# agy-switch — Multi-Account Switcher & Quota Dashboard for Antigravity CLI
#
# Usage:
#   agy-switch                     Interactive account picker and launcher
#   agy-switch [agy-flags...]      Launch agy with arguments passed through (e.g. -c)
#   agy-switch add                 Log in and save a new Google account
#   agy-switch save [name]         Save currently active session token
#   agy-switch <email|keyword>     Quick switch to a specific account
#   agy-switch list                List all saved account profiles
#   agy-switch current             Show currently active account
#   agy-switch usage [all]         Check real-time quota
#   agy-switch delete <keyword>    Delete a saved profile

set -eo pipefail

TOKEN_FILE="$HOME/.gemini/antigravity-cli/antigravity-oauth-token"
CLI_TOKEN_FILE="$TOKEN_FILE"
DESKTOP_TOKEN_FILE="$HOME/.gemini/jetski-standalone-oauth-token"
PROFILES_DIR="$HOME/.gemini/antigravity-cli/profiles"
CURRENT_FILE="$PROFILES_DIR/.current"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

mkdir -p "$PROFILES_DIR"

# ── Helpers ──

# Extract email from token file
get_email() {
    python3 -c "
import json, base64, sys
try:
    with open('$1') as f:
        data = json.load(f)
    id_token = data.get('id_token', '')
    if id_token:
        payload = id_token.split('.')[1]
        payload += '=' * (4 - len(payload) % 4)
        decoded = json.loads(base64.urlsafe_b64decode(payload))
        print(decoded.get('email', ''))
    else:
        print('')
except:
    print('')
" 2>/dev/null
}

# Extract access_token from token file
get_access_token() {
    python3 -c "
import json
with open('$1') as f:
    data = json.load(f)
print(data.get('token', {}).get('access_token', ''))
" 2>/dev/null
}

# Extract expiry from token file
get_expiry() {
    python3 -c "
import json
with open('$1') as f:
    data = json.load(f)
print(data.get('token', {}).get('expiry', 'unknown'))
" 2>/dev/null
}

# Email -> Safe filename (@ replaced with _at_)
email_to_filename() {
    echo "$1" | sed 's/@/_at_/g'
}

# Safe filename -> Email
filename_to_email() {
    echo "$1" | sed 's/_at_/@/g'
}

# ── Token Auto-Sync (CLI & Desktop unified) ──
auto_sync_tokens() {
    python3 -c "
import os, json, base64, shutil

profiles_dir = os.path.expanduser('~/.gemini/antigravity-cli/profiles')
os.makedirs(profiles_dir, exist_ok=True)

sources = [
    os.path.expanduser('~/.gemini/antigravity-cli/antigravity-oauth-token'),
    os.path.expanduser('~/.gemini/jetski-standalone-oauth-token')
]

for src_path in sources:
    if not os.path.exists(src_path):
        continue
    try:
        with open(src_path) as f:
            data = json.load(f)
        id_token = data.get('id_token', '')
        if not id_token:
            continue
        payload = id_token.split('.')[1]
        payload += '=' * (4 - len(payload) % 4)
        email = json.loads(base64.urlsafe_b64decode(payload)).get('email')
        if not email:
            continue
        fname = email.replace('@', '_at_') + '.json'
        dest = os.path.join(profiles_dir, fname)
        if not os.path.exists(dest):
            shutil.copy2(src_path, dest)
        elif os.path.getmtime(src_path) > os.path.getmtime(dest):
            shutil.copy2(src_path, dest)
    except Exception:
        pass
" 2>/dev/null || true

    # If CLI token doesn't exist but Desktop token exists, sync Desktop token to CLI
    if [[ ! -f "$TOKEN_FILE" && -f "$DESKTOP_TOKEN_FILE" ]]; then
        mkdir -p "$(dirname "$TOKEN_FILE")"
        cp "$DESKTOP_TOKEN_FILE" "$TOKEN_FILE" 2>/dev/null || true
    fi

    # Auto-initialize .current if missing
    if [[ ! -f "$CURRENT_FILE" || ! -s "$CURRENT_FILE" ]]; then
        local active_email=""
        if [[ -f "$TOKEN_FILE" ]]; then
            active_email=$(get_email "$TOKEN_FILE")
        elif [[ -f "$DESKTOP_TOKEN_FILE" ]]; then
            active_email=$(get_email "$DESKTOP_TOKEN_FILE")
        fi
        if [[ -n "$active_email" ]]; then
            echo "$(email_to_filename "$active_email")" > "$CURRENT_FILE"
        fi
    fi
}

auto_sync_tokens

# Match profile by exact email, file name, or partial keyword
find_profile() {
    local query="$1"
    local matches=()

    shopt -s nullglob
    local all_profiles=("$PROFILES_DIR"/*.json)
    shopt -u nullglob

    if [[ ${#all_profiles[@]} -eq 0 ]]; then
        echo -e "${RED}✗ No saved accounts found${NC}" >&2
        return 1
    fi

    for f in "${all_profiles[@]}"; do
        local name
        name=$(basename "$f" .json)
        local email
        email=$(filename_to_email "$name")

        if [[ "$email" == "$query" || "$name" == "$query" ]]; then
            echo "$f"
            return 0
        fi
    done

    for f in "${all_profiles[@]}"; do
        local name
        name=$(basename "$f" .json)
        local email
        email=$(filename_to_email "$name")

        if [[ "$email" == *"$query"* || "$name" == *"$query"* ]]; then
            matches+=("$f")
        fi
    done

    if [[ ${#matches[@]} -eq 1 ]]; then
        echo "${matches[0]}"
        return 0
    elif [[ ${#matches[@]} -gt 1 ]]; then
        echo -e "${RED}✗ Multiple matching accounts found:${NC}" >&2
        for f in "${matches[@]}"; do
            local name
            name=$(basename "$f" .json)
            echo -e "    $(filename_to_email "$name")" >&2
        done
        echo -e "${YELLOW}Please specify a more specific keyword.${NC}" >&2
        return 1
    else
        echo -e "${RED}✗ No account matching '$query' found${NC}" >&2
        cmd_list >&2
        return 1
    fi
}

# ── Core Commands ──

cmd_save() {
    local alias_name="${1:-}"
    local target_token="$TOKEN_FILE"
    if [[ ! -f "$target_token" ]]; then
        if [[ -f "$DESKTOP_TOKEN_FILE" ]]; then
            target_token="$DESKTOP_TOKEN_FILE"
        else
            echo -e "${RED}✗ Token file not found. Please log in with agy or Antigravity Desktop first.${NC}"
            exit 1
        fi
    fi

    local email
    email=$(get_email "$target_token")

    if [[ -z "$email" ]]; then
        echo -e "${RED}✗ Unable to parse email from token file.${NC}"
        exit 1
    fi

    local filename
    if [[ -n "$alias_name" ]]; then
        filename="$alias_name"
    else
        filename=$(email_to_filename "$email")
    fi

    cp "$target_token" "$PROFILES_DIR/$filename.json"
    echo "$filename" > "$CURRENT_FILE"
    echo -e "${GREEN}✓ Saved account: ${CYAN}$email${NC}"
}

cmd_switch() {
    local query="$1"
    local profile
    profile=$(find_profile "$query") || exit 1

    # Auto-backup existing active token if not yet saved in profiles
    if [[ -f "$TOKEN_FILE" ]]; then
        local active_email
        active_email=$(get_email "$TOKEN_FILE")
        if [[ -n "$active_email" ]]; then
            local active_file="$PROFILES_DIR/$(email_to_filename "$active_email").json"
            if [[ ! -f "$active_file" ]]; then
                cp "$TOKEN_FILE" "$active_file"
                echo -e "${GREEN}✓ Auto-saved discovered account: ${CYAN}$active_email${NC}"
            fi
        fi
    fi

    mkdir -p "$(dirname "$TOKEN_FILE")"
    cp "$profile" "$TOKEN_FILE"

    # Synchronize to Desktop token as well (treat equally)
    if [[ -d "$HOME/.gemini" ]]; then
        cp "$profile" "$DESKTOP_TOKEN_FILE" 2>/dev/null || true
    fi

    local name
    name=$(basename "$profile" .json)
    echo "$name" > "$CURRENT_FILE"
    local email
    email=$(filename_to_email "$name")
    echo -e "${GREEN}✓ Switched to: ${CYAN}$email${NC}"
    echo -e "${DIM}(Synced across Antigravity CLI and Desktop)${NC}"
    echo -e "${YELLOW}Note: If agy or Desktop is currently running, restart it to apply the new account.${NC}"
}

cmd_list() {
    shopt -s nullglob
    local all_profiles=("$PROFILES_DIR"/*.json)
    shopt -u nullglob

    if [[ ${#all_profiles[@]} -eq 0 ]]; then
        echo -e "${YELLOW}No accounts saved yet.${NC}"
        echo -e "Use ${CYAN}agy-switch save${NC} or ${CYAN}agy-switch add${NC} to add an account."
        return
    fi

    local current=""
    [[ -f "$CURRENT_FILE" ]] && current=$(cat "$CURRENT_FILE")

    echo -e "${BOLD}Saved accounts:${NC}"
    echo ""
    for f in "${all_profiles[@]}"; do
        local name
        name=$(basename "$f" .json)
        local email
        email=$(filename_to_email "$name")
        if [[ "$name" == "$current" ]]; then
            echo -e "  ${GREEN}▶ $email${NC}  ${GREEN}← active${NC}"
        else
            echo -e "    $email"
        fi
    done
    echo ""
}

cmd_current() {
    if [[ -f "$CURRENT_FILE" ]]; then
        local current
        current=$(cat "$CURRENT_FILE")
        local email
        email=$(filename_to_email "$current")
        echo -e "${GREEN}Active account: ${CYAN}$email${NC}"
    else
        echo -e "${YELLOW}No active account recorded.${NC}"
    fi
}

cmd_usage() {
    local check_all=false
    for arg in "$@"; do
        [[ "$arg" == "all" || "$arg" == "-a" ]] && check_all=true
    done

    if $check_all; then
        shopt -s nullglob
        local all_profiles=("$PROFILES_DIR"/*.json)
        shopt -u nullglob

        if [[ ${#all_profiles[@]} -eq 0 ]]; then
            echo -e "${YELLOW}No accounts saved yet.${NC}"
            return
        fi

        local current=""
        [[ -f "$CURRENT_FILE" ]] && current=$(cat "$CURRENT_FILE")

        echo -e "${DIM}Querying quotas concurrently across all accounts...${NC}"

        local work_dir
        work_dir=$(mktemp -d)

        local pids=()
        local idx=0
        local profile_emails=()
        local profile_markers=()

        for f in "${all_profiles[@]}"; do
            local name
            name=$(basename "$f" .json)
            local email
            email=$(filename_to_email "$name")
            local marker=""
            [[ "$name" == "$current" ]] && marker="  ${GREEN}← active${NC}"

            profile_emails+=("$email")
            profile_markers+=("$marker")

            _parallel_query_worker "$f" "$work_dir/$idx.out" &
            pids+=($!)
            idx=$((idx + 1))
        done

        for pid in "${pids[@]}"; do
            wait "$pid" 2>/dev/null || true
        done

        for i in "${!profile_emails[@]}"; do
            local email="${profile_emails[$i]}"
            local marker="${profile_markers[$i]}"
            local raw=""
            [[ -f "$work_dir/$i.out" ]] && raw=$(cat "$work_dir/$i.out")
            echo ""
            _render_raw_quota "$email" "$marker" "$raw"
        done

        rm -rf "$work_dir"
        echo ""
    else
        local target_token="$TOKEN_FILE"
        if [[ ! -f "$target_token" ]]; then
            if [[ -f "$DESKTOP_TOKEN_FILE" ]]; then
                target_token="$DESKTOP_TOKEN_FILE"
            else
                echo -e "${RED}✗ Not logged in${NC}"
                exit 1
            fi
        fi
        local email
        email=$(get_email "$target_token")
        local raw
        raw=$(_query_usage_isolated "$target_token")
        _render_raw_quota "$email" "" "$raw"
    fi
}

_parallel_query_worker() {
    local token_file="$1"
    local outfile="$2"
    _query_usage_isolated "$token_file" > "$outfile" 2>/dev/null
}

_query_usage_isolated() {
    local token_src="$1"
    python3 -c "
import tempfile, shutil, os, subprocess, sys

token_src = sys.argv[1]
tmp_home = tempfile.mkdtemp()
dest_dir = os.path.join(tmp_home, '.gemini/antigravity-cli')
os.makedirs(dest_dir, exist_ok=True)
shutil.copy2(token_src, os.path.join(dest_dir, 'antigravity-oauth-token'))
settings_src = os.path.expanduser('~/.gemini/antigravity-cli/settings.json')
if os.path.exists(settings_src):
    shutil.copy2(settings_src, os.path.join(dest_dir, 'settings.json'))

env = os.environ.copy()
env['HOME'] = tmp_home

try:
    res = subprocess.run(['agy', '-p', '/usage', '--print-timeout', '12s'], env=env, capture_output=True, text=True, timeout=18)
    lines = [l for l in res.stdout.splitlines() if not l.startswith('Quota:') and not l.startswith('Script') and l.strip()]
    if lines:
        print('\n'.join(lines))
except Exception:
    pass
finally:
    shutil.rmtree(tmp_home, ignore_errors=True)
" "$token_src" 2>/dev/null
}

_render_raw_quota() {
    local email="$1"
    local marker="$2"
    local raw="$3"

    if [[ -z "$raw" ]]; then
        echo -e "  ${CYAN}${BOLD}$email${NC}${marker}"
        echo -e "    ${RED}✗ Query failed (token may need refreshing)${NC}"
        return
    fi

    echo "$raw" | python3 -c "
import sys

G = '\033[0;32m'
Y = '\033[1;33m'
R = '\033[0;31m'
C = '\033[0;36m'
B = '\033[1m'
D = '\033[2m'
NC = '\033[0m'

email = '''$email'''
marker = '''$marker'''

print(f'  {C}{B}{email}{NC}{marker}')

lines = [l.strip() for l in sys.stdin if l.strip()]

groups = {}
for line in lines:
    parts = line.split('\t')
    if len(parts) < 3:
        parts = line.split()
        if len(parts) < 3:
            continue
    pct_str = None
    model = None
    period = None
    for i, p in enumerate(parts):
        if p.endswith('%'):
            try:
                pct_str = int(p.replace('%', ''))
                full = ' '.join(parts[:i])
                if 'Weekly' in full or 'weekly' in full:
                    period = 'Weekly'
                    model = full.split('Weekly')[0].strip().split('week')[0].strip()
                elif 'Five' in full or 'Hour' in full or 'five' in full:
                    period = '5-Hour'
                    model = full.split('Five')[0].strip().split('five')[0].strip()
                else:
                    period = 'Quota'
                    model = full.strip()
                break
            except:
                continue

    if pct_str is not None and model and period:
        model = model.replace('Limit Remaining', '').replace('Limit', '').strip()
        if model not in groups:
            groups[model] = {}
        groups[model][period] = pct_str

for model, periods in groups.items():
    short = model
    if 'Claude' in model or 'GPT' in model:
        short = 'Claude/GPT'
    elif 'Gemini' in model:
        short = 'Gemini Pro'

    parts_out = []
    for period in ['5-Hour', 'Weekly']:
        if period not in periods:
            continue
        pct = periods[period]

        filled = pct * 16 // 100
        empty = 16 - filled

        if pct >= 60:
            color = G
        elif pct >= 30:
            color = Y
        else:
            color = R

        bar = f'{color}[' + '#' * filled + '-' * empty + f']{NC}'
        pct_display = f'{pct:>3}%'
        parts_out.append(f'{period}: {bar} {color}{pct_display}{NC}')

    label = f'{short:<12}'
    print(f'    {label}  {\"   \".join(parts_out)}')
" 2>/dev/null
}

cmd_delete() {
    local query="$1"
    local profile
    profile=$(find_profile "$query") || exit 1
    local name
    name=$(basename "$profile" .json)
    local email
    email=$(filename_to_email "$name")
    rm -f "$profile"
    echo -e "${GREEN}✓ Deleted profile: $email${NC}"

    # Clean active tokens if matching deleted account to prevent re-sync
    if [[ -f "$TOKEN_FILE" ]] && [[ "$(get_email "$TOKEN_FILE")" == "$email" ]]; then
        rm -f "$TOKEN_FILE"
    fi
    if [[ -f "$DESKTOP_TOKEN_FILE" ]] && [[ "$(get_email "$DESKTOP_TOKEN_FILE")" == "$email" ]]; then
        rm -f "$DESKTOP_TOKEN_FILE"
    fi

    if [[ -f "$CURRENT_FILE" ]] && [[ "$(cat "$CURRENT_FILE")" == "$name" ]]; then
        rm -f "$CURRENT_FILE"
    fi
}

cmd_export() {
    local target="${1:-}"
    shopt -s nullglob
    local all_profiles=("$PROFILES_DIR"/*.json)
    shopt -u nullglob

    if [[ ${#all_profiles[@]} -eq 0 ]]; then
        echo -e "${RED}✗ No saved accounts found to export.${NC}"
        return 1
    fi

    # If target is not given, generate a default filename with timestamp
    if [[ -z "$target" ]]; then
        target="agy-profiles-$(date +%Y%m%d-%H%M%S).tar.gz"
    fi

    echo -e "${DIM}Exporting ${#all_profiles[@]} account profile(s)...${NC}"
    tar -czf "$target" -C "$HOME/.gemini/antigravity-cli" profiles

    echo -e "${GREEN}✓ Exported successfully to: ${CYAN}${BOLD}$target${NC}"
    echo -e "${DIM}You can copy this file to another machine and run: ${CYAN}agy-switch import $target${NC}"
}

cmd_import() {
    local file="${1:-}"
    if [[ -z "$file" || ! -f "$file" ]]; then
        echo -e "${RED}✗ Please specify an export archive to import (e.g. agy-switch import profiles.tar.gz)${NC}"
        return 1
    fi

    echo -e "${DIM}Importing account profiles from $file...${NC}"
    mkdir -p "$HOME/.gemini/antigravity-cli"
    tar -xzf "$file" -C "$HOME/.gemini/antigravity-cli"

    shopt -s nullglob
    local all_profiles=("$PROFILES_DIR"/*.json)
    shopt -u nullglob

    echo -e "${GREEN}✓ Import complete! Found ${#all_profiles[@]} account profile(s):${NC}"
    for f in "${all_profiles[@]}"; do
        local name
        name=$(basename "$f" .json)
        echo -e "  - ${CYAN}$(filename_to_email "$name")${NC}"
    done

    # If no active token exists, activate the first profile
    if [[ ! -f "$TOKEN_FILE" && ${#all_profiles[@]} -gt 0 ]]; then
        local first="${all_profiles[0]}"
        cp "$first" "$TOKEN_FILE"
        local fname
        fname=$(basename "$first" .json)
        echo "$fname" > "$CURRENT_FILE"
        echo -e "${GREEN}✓ Activated default account: ${CYAN}$(filename_to_email "$fname")${NC}"
    fi
}

cmd_add() {
    echo -e "${CYAN}${BOLD}=== Add New Google Account ===${NC}"
    echo -e "${DIM}Temporarily moving active session token to trigger OAuth login flow...${NC}"

    local backup=""
    if [[ -f "$TOKEN_FILE" ]]; then
        backup=$(mktemp)
        cp "$TOKEN_FILE" "$backup"
        rm -f "$TOKEN_FILE"
    fi

    echo -e "${YELLOW}Please complete Google login in the browser window/prompt that opens.${NC}"
    echo -e "${DIM}After logging in, exit agy and this tool will save your new account. Press Enter to continue...${NC}"
    read -r

    agy "$@" || true

    if [[ -f "$TOKEN_FILE" ]]; then
        local new_email
        new_email=$(get_email "$TOKEN_FILE")
        if [[ -n "$new_email" ]]; then
            local fname
            fname=$(email_to_filename "$new_email")
            cp "$TOKEN_FILE" "$PROFILES_DIR/$fname.json"
            echo "$fname" > "$CURRENT_FILE"
            if [[ -d "$HOME/.gemini" ]]; then
                cp "$TOKEN_FILE" "$DESKTOP_TOKEN_FILE" 2>/dev/null || true
            fi
            echo -e "${GREEN}✓ Successfully saved new account: ${CYAN}${BOLD}$new_email${NC}"
            echo -e "${DIM}(Synced across Antigravity CLI and Desktop)${NC}"
            [[ -n "$backup" ]] && rm -f "$backup"
            return 0
        fi
    fi

    echo -e "${YELLOW}No new login token detected. Restoring previous account...${NC}"
    if [[ -n "$backup" && -f "$backup" ]]; then
        cp "$backup" "$TOKEN_FILE"
        rm -f "$backup"
    fi
}

# ── Smart Automation & Reset Kickstart ──

_probe_model_isolated() {
    local token_src="$1"
    local model="$2"
    local tmp_home
    tmp_home=$(mktemp -d)

    mkdir -p "$tmp_home/.gemini/antigravity-cli"
    cp "$HOME/.gemini/antigravity-cli/settings.json" "$tmp_home/.gemini/antigravity-cli/" 2>/dev/null || true
    cp "$token_src" "$tmp_home/.gemini/antigravity-cli/antigravity-oauth-token" 2>/dev/null || true

    HOME="$tmp_home" timeout 20 script -qec "agy -p 'hi' --model '$model' --print-timeout 15s" /dev/null \
        </dev/null >/dev/null 2>&1 || true

    rm -rf "$tmp_home"
}

_pick_best_account_internal() {
    shopt -s nullglob
    local all_profiles=("$PROFILES_DIR"/*.json)
    shopt -u nullglob

    if [[ ${#all_profiles[@]} -eq 0 ]]; then
        echo "NONE||No saved accounts found"
        return
    fi

    local work_dir
    work_dir=$(mktemp -d)

    local pids=()
    local idx=0
    local profile_emails=()

    for f in "${all_profiles[@]}"; do
        local name
        name=$(basename "$f" .json)
        profile_emails+=("$(filename_to_email "$name")")
        _parallel_query_worker "$f" "$work_dir/$idx.out" &
        pids+=($!)
        idx=$((idx + 1))
    done

    for pid in "${pids[@]}"; do
        wait "$pid" 2>/dev/null || true
    done

    python3 - "$work_dir" "${#profile_emails[@]}" "${profile_emails[@]}" << 'PYEOF'
import sys, json, os
from datetime import datetime, timezone

work_dir = sys.argv[1]
count = int(sys.argv[2])
emails = sys.argv[3:3+count]

def parse_iso_secs(iso_str):
    if not iso_str:
        return None
    try:
        dt = datetime.fromisoformat(iso_str.replace("Z", "+00:00"))
        now = datetime.now(timezone.utc)
        return int((dt - now).total_seconds())
    except:
        return None

def calc_time_left(secs):
    if secs is None:
        return ""
    if secs <= 0:
        return "ready"
    days = secs // 86400
    hrs = (secs % 86400) // 3600
    mins = (secs % 3600) // 60
    if days > 0:
        return f"{days}d {hrs:02d}h"
    elif hrs > 0:
        return f"{hrs}h {mins:02d}m"
    else:
        return f"{mins}m"

def parse_quota(raw):
    lines = [l.strip() for l in raw.split("\n") if l.strip()]
    models = {
        "Gemini": {"5h": None, "Week": None},
        "Claude": {"5h": None, "Week": None}
    }
    for line in lines:
        parts = line.split("\t")
        if len(parts) < 3:
            parts = line.split()
            if len(parts) < 3:
                continue

        pct = None
        period = None
        reset_time = ""
        full_text = " ".join(parts)

        m_key = "Gemini" if "Gemini" in full_text else ("Claude" if ("Claude" in full_text or "GPT" in full_text) else None)
        if not m_key:
            continue

        if "Weekly" in full_text or "weekly" in full_text:
            period = "Week"
        elif "Five" in full_text or "Hour" in full_text or "five" in full_text:
            period = "5h"

        for p in parts:
            if p.endswith("%"):
                try:
                    pct = int(p.replace("%", ""))
                except:
                    pass
            elif "T" in p and (p.endswith("Z") or "+" in p):
                reset_time = p

        if pct is not None and period:
            secs = parse_iso_secs(reset_time) if reset_time else None
            disp = calc_time_left(secs)
            models[m_key][period] = {
                "pct": pct,
                "reset_raw": reset_time,
